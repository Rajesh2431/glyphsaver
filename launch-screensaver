#!/bin/bash
# Glyphsaver: fullscreen ASCII screensaver control (one terminal per monitor).
# Short alias `gly` runs the same commands (e.g. `gly time 150`).
# Ported from basecamp/omarchy `omarchy-launch-screensaver` (quattro branch).
#
# Usage: glyphsaver <command> [args]   (short alias: gly)
#   launch | force [flags]  start (force bypasses toggle); flags pass to the loop
#   stop                    kill a running screensaver
#   toggle [on|off|status]  enable/disable idle starts (no arg flips)
#   status                  running state, toggle, engines, art, style
#   show | config           all saved settings (art, style, engine, mode, filters, fps, idle)
#   preview [EFFECT]        one effect cycle inline (any key exits)
#   preview-text "words"    render text and preview once without saving
#   ascii "words"           print Omarchy-style art to stdout (no save)
#   list-effects            the 37 available effects
#   styles                  list text styles (* = default)
#   time SECONDS            set idle timeout, e.g. `glyphsaver time 150`
#   time                    show current idle timeout
#   text "words"            change displayed text (style stays default)
#   effect NAME | random    fixed effect, or back to random
#   include "a b" | clear   random pool allow-list (clears exclude)
#   exclude "a b" | clear   random pool block-list (clears include)
#   fps N                   frame rate 1-1000 (default 120)
#   engine auto|ttfx|tte    effects engine
#   style NAME | auto       default text style (see: glyphsaver styles)
#   size auto|1-8          art scaling: auto-fill screen (default), 1 = original
#   set-image IMG           convert PNG/SVG to ASCII art (needs chafa)
#   set-art FILE            use an existing .txt art file
#   arts                    list bundled presets (heroes, cars, funny, Japanese)
#   art NAME                use a bundled preset, e.g. glyphsaver art batman
#   paste                   paste your own ASCII art (stdin, end with Ctrl-D)
#   edit-art                open current art in $EDITOR
#   reset-art               restore bundled logo
#   help                    this help
#
# Loop flags (--effect, --fps, --include, --exclude, --engine, --art, --random)
# may follow launch/force/preview for one-off runs without saving.

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)"
INNER="$SCRIPT_DIR/screensaver"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh" 2>/dev/null || source /usr/share/glyphsaver/lib.sh
ASSET_DIR="$(ss_asset_dir)"
# Installed layout: binaries live on PATH, assets under /usr/share.
if [[ ! -x "$INNER" ]] && command -v glyphsaver-loop &>/dev/null; then
  INNER="$(command -v glyphsaver-loop)"
fi
STATE_DIR="$HOME/.local/state/glyphsaver"
OFF_FILE="$STATE_DIR/off"
CONFIG_DIR="$HOME/.config/glyphsaver"
CONFIG_FILE="$CONFIG_DIR/config"

[[ -x "$INNER" ]] || {
  echo "Error: inner script not found/executable: $INNER" >&2
  exit 1
}
mkdir -p "$STATE_DIR" "$CONFIG_DIR"

# Art resolution: legacy omarchy path > local art > bundled logo.
resolve_art() {
  ss_resolve_art
}

write_art() {
  ss_write_art "$@"
  echo "Art updated."
}

is_running() {
  if command -v hyprctl &>/dev/null; then
    hyprctl clients -j 2>/dev/null | jq -e '[.[] | select(.class == "glyphsaver")] | length > 0' >/dev/null 2>&1
  else
    local p
    p=$(pgrep -f '[g]lyphsaver' 2>/dev/null | grep -v "^$$\$" || true)
    [[ -n "$p" ]]
  fi
}
is_off() { [[ -f "$OFF_FILE" ]]; }

cmd_status() {
  is_running && echo "screensaver: RUNNING" || echo "screensaver: stopped"
  is_off && echo "idle screensaver: OFF" || echo "idle screensaver: ON"
  echo "engine: $(command -v ttfx &>/dev/null && echo "ttfx ($(command -v ttfx))" || echo "ttfx missing"), $(command -v tte &>/dev/null && echo "tte ($(command -v tte))" || echo "tte missing")"
  echo "art: $(resolve_art)"
  _font="$(ss_config_get SCREENSAVER_FONT "$CONFIG_FILE")"
  echo "style: ${_font:-auto-fit} (change text anytime with set-text; style stays)"
}

cmd_toggle() {
  case "${1:-}" in
  on)
    rm -f "$OFF_FILE"
    echo "idle screensaver: ON"
    ;;
  off)
    touch "$OFF_FILE"
    echo "idle screensaver: OFF"
    ;;
  status)
    is_off && echo "OFF" || echo "ON"
    ;;
  *)
    if is_off; then
      rm -f "$OFF_FILE"
      echo "idle screensaver: ON"
    else
      touch "$OFF_FILE"
      echo "idle screensaver: OFF"
    fi
    ;;
  esac
}

cmd_preview() {
  local effect="${1:-}"
  if [[ -n "$effect" ]]; then
    exec "$INNER" --once --effect "$effect" "${PASSTHROUGH[@]}"
  else
    exec "$INNER" --once "${PASSTHROUGH[@]}"
  fi
}

cmd_set_text() {
  local text="${1:-}"
  [[ -z "$text" ]] && {
    echo "Usage: glyphsaver text \"Your Text\"" >&2
    return 1
  }
  local tmp style _stored _font
  tmp=$(mktemp)
  # Reuse the stored default style; empty/unset means auto-fit, and the
  # first auto-fit becomes the default. Overlong text cascades smaller
  # but never changes the default.
  _stored="$(ss_config_get SCREENSAVER_FONT "$CONFIG_FILE")"
  style=$(ss_render_text "$text" "$tmp" "$_stored")
  write_art "$tmp" 1
  echo "Style: $style"
  if [[ -z "$_stored" ]]; then
    _font="$(ss_style_name "$style")"
    ss_config_set SCREENSAVER_FONT "$_font" "$CONFIG_FILE"
    echo "Style saved as default: $_font"
  fi
  rm -f "$tmp"
}

cmd_time() {
  local arg="${1:-}"
  local idle_conf="$HOME/.config/glyphsaver/idle.conf"
  if [[ -z "$arg" ]]; then
    echo "idle timeout: $(ss_config_get IDLE_SCREENSAVER "$idle_conf")s (swayidle)"
    return 0
  fi
  [[ "$arg" =~ ^[0-9]+$ ]] && ((arg > 0)) || {
    echo "Usage: glyphsaver time SECONDS  (e.g. glyphsaver time 150)" >&2
    return 1
  }
  ((arg >= 600)) && echo "Note: the screen locks around 600s — start the saver before that."
  [[ -f "$idle_conf" ]] || cp "$ASSET_DIR/idle/idle.conf.example" "$idle_conf" 2>/dev/null || true
  ss_config_set IDLE_SCREENSAVER "$arg" "$idle_conf"
  echo "idle timeout set to ${arg}s."
  if systemctl --user restart glyphsaver-idle.service 2>/dev/null; then
    echo "idle service restarted."
  else
    echo "Start the idle service: systemctl --user enable --now glyphsaver-idle.service"
  fi
}

cmd_effect() {
  local arg="${1:-}"
  if [[ -z "$arg" ]]; then
    echo "mode: $(ss_config_get SCREENSAVER_MODE "$CONFIG_FILE")"
    echo "effect: $(ss_config_get SCREENSAVER_EFFECT "$CONFIG_FILE")"
    return 0
  fi
  if [[ "$arg" == "random" ]]; then
    ss_config_set SCREENSAVER_MODE "random" "$CONFIG_FILE"
    echo "effect: random"
    return 0
  fi
  if "$INNER" --list-effects 2>/dev/null | grep -qx "$arg"; then
    ss_config_set SCREENSAVER_MODE "single" "$CONFIG_FILE"
    ss_config_set SCREENSAVER_EFFECT "$arg" "$CONFIG_FILE"
    echo "effect: $arg"
  else
    echo "Unknown effect: $arg (see: glyphsaver list-effects)" >&2
    return 1
  fi
}

cmd_filter() {
  local which="$1" arg="${2:-}"
  local key other
  if [[ "$which" == "include" ]]; then
    key="SCREENSAVER_INCLUDE"
    other="SCREENSAVER_EXCLUDE"
  else
    key="SCREENSAVER_EXCLUDE"
    other="SCREENSAVER_INCLUDE"
  fi
  if [[ -z "$arg" ]]; then
    echo "$which: $(ss_config_get "$key" "$CONFIG_FILE")"
    return 0
  fi
  if [[ "$arg" == "clear" ]]; then
    ss_config_set "$key" "" "$CONFIG_FILE"
    echo "$which cleared."
    return 0
  fi
  local fx bad=""
  for fx in $arg; do
    "$INNER" --list-effects 2>/dev/null | grep -qx "$fx" || bad="$bad $fx"
  done
  if [[ -n "$bad" ]]; then
    echo "Unknown effect(s):$bad (see: glyphsaver list-effects)" >&2
    return 1
  fi
  ss_config_set "$key" "$arg" "$CONFIG_FILE"
  ss_config_set "$other" "" "$CONFIG_FILE"
  echo "$which: $arg  (the other filter was cleared — they can't combine)"
}

cmd_fps() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && {
    echo "fps: $(ss_config_get SCREENSAVER_FPS "$CONFIG_FILE")"
    return 0
  }
  [[ "$arg" =~ ^[0-9]+$ ]] && ((arg >= 1 && arg <= 1000)) || {
    echo "Usage: glyphsaver fps 1-1000  (e.g. glyphsaver fps 120)" >&2
    return 1
  }
  ss_config_set SCREENSAVER_FPS "$arg" "$CONFIG_FILE"
  echo "fps: $arg"
}

cmd_engine() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && {
    echo "engine: $(ss_config_get SCREENSAVER_ENGINE "$CONFIG_FILE")"
    return 0
  }
  case "$arg" in
  auto | ttfx | tte) ;;
  *)
    echo "Usage: glyphsaver engine auto|ttfx|tte" >&2
    return 1
    ;;
  esac
  if [[ "$arg" != "auto" ]] && ! command -v "$arg" &>/dev/null; then
    echo "Warning: '$arg' is not on PATH." >&2
  fi
  ss_config_set SCREENSAVER_ENGINE "$arg" "$CONFIG_FILE"
  echo "engine: $arg"
}

cmd_style() {
  local arg="${1:-}"
  [[ -z "$arg" ]] && {
    echo "style: $(ss_config_get SCREENSAVER_FONT "$CONFIG_FILE")"
    return 0
  }
  if [[ "$arg" == "auto" ]]; then
    ss_config_set SCREENSAVER_FONT "" "$CONFIG_FILE"
  elif ss_valid_style "$arg"; then
    ss_config_set SCREENSAVER_FONT "$arg" "$CONFIG_FILE"
  else
    echo "Usage: glyphsaver style <name>|auto  (see: glyphsaver styles)" >&2
    return 1
  fi
  echo "style: ${arg:-auto-fit}"
}

cmd_size() {
  # View or set art scaling: auto (fill screen, default) | 1 (off) | 2-8.
  local arg="${1:-}"
  if [[ -z "$arg" ]]; then
    echo "size: $(ss_config_get SCREENSAVER_SCALE "$CONFIG_FILE")"
    echo "(blank = auto-fill screen; 1 = original size; N = fixed scale)"
    return 0
  fi
  if [[ "$arg" == "auto" ]]; then
    ss_config_set SCREENSAVER_SCALE "" "$CONFIG_FILE"
  elif [[ "$arg" =~ ^[1-8]$ ]]; then
    ss_config_set SCREENSAVER_SCALE "$arg" "$CONFIG_FILE"
  else
    echo "Usage: glyphsaver size auto|1-8" >&2
    return 1
  fi
  echo "size: ${arg:-auto-fill}"
  echo "Re-render current text to apply: glyphsaver text \"...\" (or re-set art)."
}

cmd_styles() {
  local cur
  cur="$(ss_config_get SCREENSAVER_FONT "$CONFIG_FILE")"
  local s
  for s in $(ss_list_styles); do
    if [[ "$s" == "${cur:-omarchy}" ]]; then
      echo "* $s (default)"
    else
      echo "  $s"
    fi
  done
}

cmd_show() {
  local mode effect
  mode="$(ss_config_get SCREENSAVER_MODE "$CONFIG_FILE")"
  effect="$(ss_config_get SCREENSAVER_EFFECT "$CONFIG_FILE")"
  echo "art:    $(resolve_art)"
  echo "style:  $(ss_config_get SCREENSAVER_FONT "$CONFIG_FILE")"
  echo "engine: $(ss_config_get SCREENSAVER_ENGINE "$CONFIG_FILE")"
  echo "mode:   ${mode:-random}"
  if [[ "${mode:-random}" == "single" ]]; then
    echo "effect: $effect"
  fi
  echo "include: $(ss_config_get SCREENSAVER_INCLUDE "$CONFIG_FILE")"
  echo "exclude: $(ss_config_get SCREENSAVER_EXCLUDE "$CONFIG_FILE")"
  echo "fps:    $(ss_config_get SCREENSAVER_FPS "$CONFIG_FILE")"
  echo "size:   $(ss_config_get SCREENSAVER_SCALE "$CONFIG_FILE")"
  cmd_time
  if [[ -f "$OFF_FILE" ]]; then
    echo "idle:   OFF (toggle on to re-enable)"
  else
    echo "idle:   ON"
  fi
}

detect_terminal() {
  local id=""
  if command -v xdg-terminal-exec &>/dev/null; then
    id=$(xdg-terminal-exec --print-id 2>/dev/null || true)
  fi
  [[ -z "$id" ]] && id="${TERMINAL:-}"
  if [[ -z "$id" ]]; then
    for t in alacritty ghostty kitty foot; do
      if command -v "$t" &>/dev/null; then
        id="$t"
        break
      fi
    done
  fi
  echo "$id"
}

launch() {
  # Already running?
  if is_running; then
    echo "Screensaver already running."
    return 0
  fi

  # No Hyprland: run inline.
  if ! command -v hyprctl &>/dev/null; then
    exec "$INNER" "${PASSTHROUGH[@]}"
  fi

  local terminal terminal_fallback=""
  terminal=$(detect_terminal)
  case "$terminal" in
  *Alacritty* | *alacritty*) terminal="alacritty" ;;
  *ghostty* | *Ghostty*) terminal="ghostty" ;;
  *foot*) terminal="foot" ;;
  *kitty* | *Kitty*) terminal="kitty" ;;
  *)
    if [[ -n "$terminal" ]] && command -v "${terminal%% *}" &>/dev/null; then
      # Unknown terminal (wezterm, konsole, ...): most accept `-e`.
      # Fullscreen rules key off the window class, so they may not apply —
      # the saver still runs, just possibly windowed.
      echo "Note: '$terminal' has no tuned fullscreen flags; trying generic '-e'." >&2
      echo "For guaranteed fullscreen use Alacritty, Foot, Ghostty, or Kitty." >&2
      terminal_fallback="$terminal"
      terminal="generic"
    else
      echo "Screensaver needs a terminal (found: '${terminal:-none}')." >&2
      echo "Install one: sudo pacman -S alacritty foot kitty" >&2
      return 1
    fi
    ;;
  esac

  # Forward passthrough args to the inner script (quoted safely).
  local inner_cmd
  printf -v inner_cmd '%q ' "$INNER" "${PASSTHROUGH[@]}"
  inner_cmd="${inner_cmd% }"

  # %q-quote a path for embedding in the bash -lc string (no raw quotes).
  local q_asset_alacritty q_asset_ghostty q_asset_foot
  printf -v q_asset_alacritty '%q' "$ASSET_DIR/terminals/alacritty-screensaver.toml"
  printf -v q_asset_ghostty '%q' "$ASSET_DIR/terminals/ghostty-screensaver"
  printf -v q_asset_foot '%q' "$ASSET_DIR/terminals/foot-screensaver.ini"

  local focused
  focused=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.monitor // empty' 2>/dev/null || true)

  hypr_focus_monitor() {
    # Lua-first (Hyprland >= 0.55 evaluates dispatch as Lua), plain fallback.
    hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 ||
      hyprctl dispatch focusmonitor "$1" >/dev/null 2>&1 || true
  }

  hypr_exec() {
    local command="$1"
    # [[...]] breaks if the command contains ']]'; guard by falling back
    # to the plain exec form in that (rare) case.
    if [[ "$command" != *']]'* ]]; then
      hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 && return 0
    fi
    hyprctl dispatch exec -- bash -lc "$command" >/dev/null 2>&1 || true
  }

  focus_screensaver() {
    hyprctl dispatch "hl.dsp.focus({ window = 'class:glyphsaver' })" >/dev/null 2>&1 ||
      hyprctl dispatch focuswindow class:glyphsaver >/dev/null 2>&1 || true
  }

  # Discover the event socket even when systemd didn't pass Hyprland env.
  : "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
  if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    _sock_dir=$(ls -td "$XDG_RUNTIME_DIR"/hypr/*/ 2>/dev/null | head -1)
    [[ -n "${_sock_dir:-}" ]] && HYPRLAND_INSTANCE_SIGNATURE="$(basename "$_sock_dir")"
    unset _sock_dir
  fi
  local socket="${XDG_RUNTIME_DIR}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock"
  local events=""
  if [[ -S "$socket" ]]; then
    exec {events}< <(socat -U - "UNIX-CONNECT:$socket")
  fi

  wait_for_screensaver_window() {
    if [[ -z "${events:-}" ]]; then
      sleep 0.4
      return 0
    fi
    local line deadline=$((SECONDS + 5))
    while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
      [[ $line == openwindow\>\>*,glyphsaver,* ]] && return 0
    done
  }

  while IFS= read -r m; do
    [[ -z "$m" ]] && continue
    hypr_focus_monitor "$m"
    case "$terminal" in
    alacritty)
      hypr_exec "alacritty --class=glyphsaver --config-file $q_asset_alacritty -e $inner_cmd"
      ;;
    ghostty)
      hypr_exec "ghostty --class=glyphsaver --config-file=$q_asset_ghostty --font-size=18 -e $inner_cmd"
      ;;
    foot)
      hypr_exec "foot --app-id=glyphsaver --config=$q_asset_foot -e $inner_cmd"
      ;;
    kitty)
      hypr_exec "kitty --class=glyphsaver --override font_size=18 --override window_padding_width=0 -e $inner_cmd"
      ;;
    generic)
      # Most terminals accept -e; gnome-terminal needs '--'. Try -- first.
      if [[ "$terminal_fallback" == *gnome-terminal* ]]; then
        hypr_exec "$terminal_fallback -- $inner_cmd"
      else
        hypr_exec "$terminal_fallback -e $inner_cmd"
      fi
      ;;
    esac
    wait_for_screensaver_window
    # New windows don't always take focus on their own (setup-dependent);
    # without focus the loop below would exit immediately.
    focus_screensaver
  done < <(hyprctl monitors -j 2>/dev/null | jq -r '.[] | .name // empty' 2>/dev/null)

  # A saver window must hold focus or the loop inside exits. Focus lands
  # asynchronously (and silently fails if the window isn't mapped yet),
  # so re-assert until it sticks — then restore the original monitor only
  # if no saver ended up focused (refocusing would yank focus away and
  # instantly exit the saver we just started).
  for _ in 1 2 3 4 5 6; do
    hyprctl activewindow -j 2>/dev/null | jq -e '.class == "glyphsaver"' >/dev/null 2>&1 && break
    focus_screensaver
    sleep 0.5
  done
  if [[ -n "$focused" ]] && ! hyprctl activewindow -j 2>/dev/null | jq -e '.class == "glyphsaver"' >/dev/null 2>&1; then
    hypr_focus_monitor "$focused"
  fi
}

# --- subcommand dispatch (collect passthrough flags first) ---
PASSTHROUGH=()
CMD="${1:-launch}"
shift || true
EXTRA=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --effect | --fps | --include | --exclude | --engine | --art)
    PASSTHROUGH+=("$1" "$2")
    shift 2
    ;;
  --random | --once)
    PASSTHROUGH+=("$1")
    shift
    ;;
  *)
    EXTRA+=("$1")
    shift
    ;;
  esac
done
set -- "${EXTRA[@]:-}"

case "$CMD" in
launch | force | "")
  if [[ "$CMD" != "force" ]] && is_off; then
    exit 0
  fi
  launch
  ;;
stop)
  # Stop only our own saver: close compositor windows, kill loop + its
  # engines (marked with --reuse-canvas). Never pkill all ttfx/tte.
  if command -v hyprctl &>/dev/null; then
    hyprctl dispatch closewindow class:glyphsaver >/dev/null 2>&1 || true
  fi
  pkill -f 'ttfx.*--reuse-canvas' 2>/dev/null || true
  pkill -f 'tte.*--reuse-canvas' 2>/dev/null || true
  pkill -f '[g]lyphsaver-loop' 2>/dev/null || true
  command -v hyprctl &>/dev/null && hyprctl keyword cursor:invisible false &>/dev/null || true
  echo "Screensaver stopped."
  ;;
toggle)
  cmd_toggle "${1:-}"
  ;;
status)
  cmd_status
  ;;
preview)
  cmd_preview "${1:-}"
  ;;
preview-text)
  # Render text and preview it once without saving: glyphsaver preview-text "Hi 123"
  _pt=$(mktemp)
  _ps=$(ss_render_text "$*" "$_pt" "$(ss_config_get SCREENSAVER_FONT "$CONFIG_FILE")")
  echo "Previewing ($_ps) — any key exits."
  "$INNER" --once --art "$_pt" "${PASSTHROUGH[@]}"
  printf '\033[?25h'
  rm -f "$_pt"
  ;;
ascii)
  # Print Omarchy-style art to stdout without saving: glyphsaver ascii "Hi 123"
  exec "$(ss_ascii_bin)" "$*"
  ;;
list-effects)
  exec "$INNER" --list-effects
  ;;
set-text | text)
  cmd_set_text "$*"
  ;;
set-image)
  img="${1:-}"
  [[ -f "${img:-}" ]] || {
    echo "Usage: glyphsaver set-image LOGO.png" >&2
    exit 1
  }
  command -v chafa &>/dev/null || {
    echo "Error: 'chafa' not installed (sudo pacman -S chafa)." >&2
    exit 1
  }
  tmp=$(mktemp)
  _cw=$(ss_max_cols); _ch=$(( $(ss_max_rows) - 4 ))
  (( _ch < 10 )) && _ch=10
  chafa --format symbols --symbols braille --size "${_cw}x${_ch}" "$img" >"$tmp"
  write_art "$tmp"
  rm -f "$tmp"
  ;;
set-art)
  [[ -f "${1:-}" ]] || {
    echo "Usage: glyphsaver set-art FILE.txt  (or: glyphsaver art NAME)" >&2
    exit 1
  }
  write_art "$1"
  ;;
arts)
  # List bundled preset art (incl. Japanese AA).
  ss_list_arts
  ;;
art)
  # Use a bundled preset: glyphsaver art torii
  [[ -n "${1:-}" ]] || {
    echo "Usage: glyphsaver art NAME  (see: glyphsaver arts)" >&2
    exit 1
  }
  _af="$(ss_art_file "$1")"
  [[ -f "$_af" ]] || {
    echo "Unknown preset: $1  (see: glyphsaver arts)" >&2
    exit 1
  }
  write_art "$_af"
  echo "Art: $1"
  ;;
paste)
  # Paste your own ASCII art: pipe it in, or type/paste then Ctrl-D.
  #   wl-paste | glyphsaver paste     (Wayland clipboard)
  #   xclip -o | glyphsaver paste     (X11 clipboard)
  #   glyphsaver paste < art.txt
  if [[ -t 0 ]]; then
    echo "Paste your ASCII art below, then press Ctrl-D on an empty line:"
  fi
  _pt=$(mktemp)
  cat >"$_pt"
  if [[ ! -s "$_pt" ]] || ! grep -q '[^[:space:]]' "$_pt"; then
    echo "Empty input — keeping current art." >&2
    rm -f "$_pt"
    exit 1
  fi
  write_art "$_pt"
  rm -f "$_pt"
  echo "Art updated from paste ($(wc -l < "$(resolve_art)") lines)."
  ;;
edit-art)
  "${EDITOR:-vi}" "$(resolve_art)"
  ;;
reset-art)
  write_art "$ASSET_DIR/logo.txt"
  ;;
time)
  cmd_time "${1:-}"
  ;;
effect)
  cmd_effect "${1:-}"
  ;;
include)
  cmd_filter include "$*"
  ;;
exclude)
  cmd_filter exclude "$*"
  ;;
fps)
  cmd_fps "${1:-}"
  ;;
engine)
  cmd_engine "${1:-}"
  ;;
style)
  cmd_style "${1:-}"
  ;;
size)
  cmd_size "${1:-}"
  ;;
styles)
  cmd_styles
  ;;
show | config)
  cmd_show
  ;;
-h | --help | help)
  sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
  ;;
*)
  echo "Unknown command: $CMD (see --help)" >&2
  exit 1
  ;;
esac
