#!/bin/bash
# Glyphsaver effect loop: text effects over ASCII art, cycling until dismissed.
# Ported from basecamp/omarchy `omarchy-screensaver` (quattro branch).
# Engine: `ttfx` (Rust, preferred) or `tte` (Python) — flags are identical.
#
# Usage: glyphsaver-loop [options]
#   --art FILE            art file (default: config art, omarchy branding, logo.txt)
#   --engine ttfx|tte     engine (default: auto = ttfx, then tte)
#   --fps N               frame rate (default: 120)
#   --random              random effect each cycle (default)
#   --effect NAME         single effect, repeated
#   --include "a b"       only these effects in random mode
#   --exclude "a b"       skip these effects in random mode
#   --once                run one effect cycle then exit (for preview)
#   --list-effects        print available effects and exit
#   -h, --help
#
# Config file ~/.config/glyphsaver/config (env vars):
#   SCREENSAVER_ENGINE, SCREENSAVER_FPS, SCREENSAVER_MODE (random|single),
#   SCREENSAVER_EFFECT, SCREENSAVER_INCLUDE, SCREENSAVER_EXCLUDE, SCREENSAVER_ART
# CLI flags override config file, which overrides builtins.

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/lib.sh" 2>/dev/null || source /usr/share/glyphsaver/lib.sh
CONFIG_FILE="$HOME/.config/glyphsaver/config"
# shellcheck disable=SC1090
[[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE"

ART="${SCREENSAVER_ART:-$(ss_resolve_art)}"
FALLBACK_ART="$(ss_asset_dir)/logo.txt"
ENGINE="${SCREENSAVER_ENGINE:-auto}"
FPS="${SCREENSAVER_FPS:-120}"
MODE="${SCREENSAVER_MODE:-random}"
EFFECT="${SCREENSAVER_EFFECT:-matrix}"
INCLUDE="${SCREENSAVER_INCLUDE:-}"
EXCLUDE="${SCREENSAVER_EXCLUDE:-}"
ONCE=0

KNOWN_EFFECTS="beams binarypath blackhole bouncyballs bubbles burn colorshift crumble decrypt errorcorrect expand fireworks highlight laseretch matrix middleout orbittingvolley overflow pour print rain randomsequence rings scattered slice slide smoke spotlights spray swarm sweep synthgrid thunderstorm unstable vhstape waves wipe"

list_effects() {
  if command -v "$1" &>/dev/null; then
    "$1" --help 2>&1 | grep -oE '\{[a-z,]+(,|$)' | tr ',' '\n' | tr -d '{' | grep -v '^$' || echo "$KNOWN_EFFECTS" | tr ' ' '\n'
  else
    echo "$KNOWN_EFFECTS" | tr ' ' '\n'
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --art)
    ART="$2"
    shift 2
    ;;
  --engine)
    ENGINE="$2"
    shift 2
    ;;
  --fps)
    FPS="$2"
    shift 2
    ;;
  --effect)
    MODE="single"
    EFFECT="$2"
    shift 2
    ;;
  --random)
    MODE="random"
    shift
    ;;
  --include)
    INCLUDE="$2"
    shift 2
    ;;
  --exclude)
    EXCLUDE="$2"
    shift 2
    ;;
  --once)
    ONCE=1
    shift
    ;;
  --list-effects)
    _e="$ENGINE"
    [[ "$_e" == "auto" ]] && _e="$(command -v ttfx &>/dev/null && echo ttfx || echo tte)"
    list_effects "$_e"
    exit 0
    ;;
  -h | --help)
    sed -n '2,/^$/p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
  *)
    echo "Unknown arg: $1 (see --help)" >&2
    exit 1
    ;;
  esac
done

[[ -f "$ART" ]] || ART="$FALLBACK_ART"
if [[ ! -f "$ART" ]]; then
  echo "Error: no art file found: $ART" >&2
  exit 1
fi

# Validate config-sourced values (config file is sourced, so don't trust it).
[[ "$FPS" =~ ^[0-9]+$ ]] && ((FPS >= 1 && FPS <= 1000)) || FPS=120
case "$ENGINE" in auto | ttfx | tte) ;; *) ENGINE="auto" ;; esac
case "$MODE" in random | single) ;; *) MODE="random" ;; esac
[[ "$EFFECT" =~ ^[a-z]+$ ]] || EFFECT="matrix"

if [[ "$ENGINE" == "auto" ]]; then
  if command -v ttfx &>/dev/null; then
    ENGINE="ttfx"
  elif command -v tte &>/dev/null; then
    ENGINE="tte"
  else
    echo "Error: neither 'ttfx' nor 'tte' found." >&2
    echo "  yay -S python-terminaltexteffects   # tte" >&2
    echo "  cargo install --git https://github.com/omacom-io/ttfx  # ttfx" >&2
    exit 1
  fi
fi
command -v "$ENGINE" &>/dev/null || {
  echo "Error: engine '$ENGINE' not on PATH." >&2
  exit 1
}

BASE_ARGS=(-i "$ART" --frame-rate "$FPS" --canvas-width 0 --canvas-height 0
  --reuse-canvas --anchor-canvas c --anchor-text c --no-eol --no-restore-cursor)

MODE_ARGS=()
if [[ "$MODE" == "single" ]]; then
  MODE_ARGS=("$EFFECT")
else
  MODE_ARGS=(--random-effect)
  if [[ -n "$INCLUDE" ]]; then
    # shellcheck disable=SC2206
    MODE_ARGS+=(--include-effects $INCLUDE)
  elif [[ -n "$EXCLUDE" ]]; then
    # shellcheck disable=SC2206
    MODE_ARGS+=(--exclude-effects $EXCLUDE)
  fi
fi

is_screensaver_focused() {
  command -v hyprctl &>/dev/null || return 0
  hyprctl activewindow -j 2>/dev/null | jq -e '.class == "glyphsaver"' >/dev/null 2>&1
}

exit_screensaver() {
  command -v hyprctl &>/dev/null && hyprctl keyword cursor:invisible false &>/dev/null || true
  printf '\033[?25h'
  # Only kill engines spawned by this screensaver (they carry our
  # --reuse-canvas marker); never pkill all ttfx/tte on the system.
  pkill -f "$ENGINE.*--reuse-canvas" 2>/dev/null || true
  # Ask the compositor to close saver windows; fall back to killing only
  # our own loop processes.
  if command -v hyprctl &>/dev/null; then
    hyprctl dispatch closewindow class:glyphsaver >/dev/null 2>&1 || true
  fi
  pkill -f '[g]lyphsaver-loop' 2>/dev/null || true
  exit 0
}

trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'
printf '\033[?25l'
command -v hyprctl &>/dev/null && hyprctl keyword cursor:invisible true &>/dev/null || true

tty_dev=$(tty 2>/dev/null || true)

# Terminals allocate the pty at 80x24 and resize once the compositor
# sizes the fullscreen window. The engine measures once at startup,
# so wait for the real size first (Omarchy workaround, kept verbatim).
wait_for_terminal_resize() {
  local deadline=$((SECONDS + 2))
  while ((SECONDS < deadline)) && [[ $(stty size 2>/dev/null) == "24 80" ]]; do
    sleep 0.02
  done
}
wait_for_terminal_resize

run_once() {
  "$ENGINE" "${BASE_ARGS[@]}" "${MODE_ARGS[@]}" &
  wait $! 2>/dev/null || true
}

if ((ONCE)); then
  run_once
  printf '\033[?25h'
  exit 0
fi

STARTED=$SECONDS
# No stdin reads during the first seconds: the engine queries the terminal
# on startup and its reply bytes arrive on our stdin too — reading them
# would both corrupt the engine's startup and fake a keypress exit.
GRACE=3
# Last seen pointer position (mouse movement exits, like Omarchy).
LASTPOS=""

# Returns 0 when the user pressed a real key (exit the saver), 1 on timeout
# or on terminal-reply bytes. Every effect cycle spawns a fresh engine
# process that queries the terminal on startup, and those reply bytes
# (ESC-led) arrive on our stdin too. A lone ESC with nothing following
# within 0.12s is treated as a real keypress; longer ESC-led sequences
# (terminal replies, arrows, F-keys) are swallowed.
user_pressed_key() {
  local b
  IFS= read -r -n1 -t 1 -u 0 b || return 1
  if [[ "$b" == $'\e' ]]; then
    # Drain the rest of the escape sequence (terminal reply or special
    # key) so leftover bytes can't false-trigger the next check.
    if IFS= read -r -n1 -t 0.12 -u 0 b; then
      while IFS= read -r -n1 -t 0.05 -u 0 b; do
        :
      done
      return 1
    fi
    return 0
  fi
  return 0
}

mouse_moved() {
  # True when the pointer moved since the last call. First call arms it.
  command -v hyprctl &>/dev/null || return 1
  local pos
  pos=$(hyprctl cursorpos 2>/dev/null || true)
  [[ -z "$pos" ]] && return 1
  if [[ -z "$LASTPOS" ]]; then
    LASTPOS="$pos"
    return 1
  fi
  [[ "$pos" != "$LASTPOS" ]]
}

while true; do
  "$ENGINE" "${BASE_ARGS[@]}" "${MODE_ARGS[@]}" &
  ENGINE_PID=$!
  CYCLE_START=$SECONDS
  # Liveness check: prefer tracking our own child PID (works without a tty);
  # fall back to per-tty pgrep only when we have a usable tty name.
  engine_alive() {
    if kill -0 "$ENGINE_PID" 2>/dev/null; then
      return 0
    fi
    if [[ -n "${tty_dev:-}" && "$tty_dev" != "not a tty" ]]; then
      pgrep -t "${tty_dev#/dev/}" -x "$ENGINE" >/dev/null 2>&1
    else
      return 1
    fi
  }
  while engine_alive; do
    if ((SECONDS - CYCLE_START < 2)); then
      # Fresh engine queries the terminal on startup; don't read stdin
      # while its reply bytes are in flight.
      sleep 0.2
    elif ((SECONDS - STARTED < GRACE)); then
      sleep 0.2
    elif user_pressed_key || mouse_moved || { ! is_screensaver_focused && ((SECONDS - STARTED > 5)); }; then
      exit_screensaver
    fi
  done
done
