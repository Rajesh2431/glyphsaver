#!/bin/bash
# glyphsaver-ascii: render text as ASCII art in the Omarchy wordmark style.
# Default font is the true Omarchy wordmark (fonts/omarchy.flf, extracted
# pixel-exact from the Omarchy logo.txt; unicase with hand-drawn A-Z 0-9
# in the same style). --font picks any other bundled FIGlet face.
#
# Usage: ascii "Some text 123" | ascii < file
# Installs as `glyphsaver ascii` via the `ascii` subcommand.

set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" &>/dev/null && pwd)"
if [[ -d "$SCRIPT_DIR/fonts" ]]; then
  FONT_DIR="$SCRIPT_DIR/fonts"
else
  FONT_DIR="/usr/share/glyphsaver/fonts"
fi
FONT_NAME="omarchy"
FONT_FILE="$FONT_DIR/$FONT_NAME.flf"

usage() {
  cat <<'EOF'
Usage: ascii [--font NAME] [text...]

Renders text as ASCII art (default style: the Omarchy wordmark font).
Reads from stdin when given no text. --font picks a bundled style
(see all: ls <fonts-dir>, e.g. --font slant).
Letters, digits and spaces render; other characters are skipped.
EOF
}

words=()
while (($# > 0)); do
  case "$1" in
  --help)
    usage
    exit 0
    ;;
  --font)
    if [[ "${1:-}" == *"="* ]]; then
      FONT_NAME="${1#*=}"
      FONT_NAME="${FONT_NAME%.flf}"
      FONT_FILE="$FONT_DIR/$FONT_NAME.flf"
    else
      if [[ -z "${2:-}" || "${2:-}" == -* ]]; then
        echo "Missing value for --font (see: glyphsaver styles)" >&2
        exit 1
      fi
      FONT_NAME="$2"
      FONT_NAME="${FONT_NAME%.flf}"
      FONT_FILE="$FONT_DIR/$FONT_NAME.flf"
      shift
    fi
    ;; # outer shift below consumes the flag itself (or the = form)
  --font=*)
    FONT_NAME="${1#--font=}"
    FONT_NAME="${FONT_NAME%.flf}"
    FONT_FILE="$FONT_DIR/$FONT_NAME.flf"
    ;;
  --)
    shift
    words+=("$@")
    break
    ;;
  -?*)
    echo "Unknown option: $1" >&2
    usage >&2
    exit 1
    ;;
  *)
    words+=("$1")
    ;;
  esac
  shift
done

if ((${#words[@]} > 0)); then
  text="${words[*]}"
elif [[ ! -t 0 ]]; then
  text=$(cat)
else
  usage >&2
  exit 1
fi

if [[ -z ${text//[[:space:]]/} ]]; then
  echo "Nothing to render" >&2
  exit 1
fi

[[ -f "$FONT_FILE" ]] || {
  echo "Font not found: $FONT_FILE (see: glyphsaver styles)" >&2
  exit 1
}

# Layout: the Omarchy wordmark font carries fixed bearings (gaps encoded
# in the glyphs, like the logo) so it concatenates with no sliding;
# Delta-Corps-Priest-1 is kerned tight; stock faces use full-width layout.
case "$FONT_NAME" in
omarchy) KERN=2 ;;
Delta-Corps-Priest-1) KERN=1 ;;
*) KERN=0 ;;
esac

printf '%s' "$text" | awk -v FONT_FILE="$FONT_FILE" -v KERN="$KERN" '
function rtrim(s) {
  sub(/ +$/, "", s)
  return s
}

function ltrim(s) {
  sub(/^ +/, "", s)
  return s
}

function replace(s, from, to,   at, result) {
  while ((at = index(s, from)) > 0) {
    result = result substr(s, 1, at - 1) to
    s = substr(s, at + 1)
  }

  return result s
}

function load_font(   line, header, position, code, i) {
  while ((getline line < FONT_FILE) > 0) {
    font_line++

    if (font_line == 1) {
      split(line, header, " ")
      hardblank = substr(header[1], length(header[1]))
      height = header[2]
      comment_lines = header[6]
      continue
    }

    if (font_line <= comment_lines + 1) {
      continue
    }

    position = font_line - comment_lines - 2
    code = 32 + int(position / height)
    if (code > 126) {
      continue
    }

    if (endmark == "") {
      endmark = substr(line, length(line))
    }

    while (length(line) > 0 && substr(line, length(line)) == endmark) {
      line = substr(line, 1, length(line) - 1)
    }

    for (i = 1; i <= blocks; i++) {
      gsub(block[i], stand_in[i], line)
    }

    line = replace(line, hardblank, hardblank_mark)

    glyph[code, position % height] = line
    if (length(line) > width[code]) {
      width[code] = length(line)
    }
  }

  close(FONT_FILE)
}

function drawable(source,   chars, total, i, code) {
  total = split(source, chars, "")
  for (i = 1; i <= total; i++) {
    code = code_of[chars[i]]
    if (code != "" && width[code] > 0) {
      return 1
    }
  }

  return 0
}

function draw(source,   chars, total, i, r, ch, code, piece, glyph_width, out, trail, amount, lead, cut, keep, remaining, fragment, body, pad, line, drew) {
  total = split(source, chars, "")
  drew = 0

  for (i = 1; i <= total; i++) {
    ch = chars[i]
    code = code_of[ch]

    if (code == "" || width[code] == 0) {
      if (!(ch in skipped)) {
        skipped[ch] = 1
        skipped_list[++skipped_total] = (ch in escaped) ? escaped[ch] : ch
      }

      continue
    }

    glyph_width = width[code]
    for (r = 0; r < height; r++) {
      piece[r] = sprintf("%-" glyph_width "s", glyph[code, r])
    }

    if (!drew) {
      if (KERN == 2) {
        for (r = 0; r < height; r++) {
          out[r] = piece[r]
          trail[r] = 0
        }
      } else {
        for (r = 0; r < height; r++) {
          out[r] = rtrim(piece[r])
          trail[r] = glyph_width - length(out[r])
        }
      }

      drew = 1
      continue
    }

    amount = -1
    if (KERN == 2) {
      # Fixed bearings (Omarchy wordmark): glyphs abut exactly as drawn.
      for (r = 0; r < height; r++) {
        out[r] = out[r] piece[r]
      }
      drew = 1
      continue
    }
    if (!KERN) {
      # Full-width layout (like figlet default): glyphs sit side by side,
      # only separated from the previous art by one column when needed.
      for (r = 0; r < height; r++) {
        if (drew && substr(out[r], length(out[r])) != " ") {
          out[r] = out[r] " "
        }
        out[r] = out[r] piece[r]
      }
      drew = 1
      continue
    }
    for (r = 0; r < height; r++) {
      lead = glyph_width - length(ltrim(piece[r]))
      if (amount < 0 || trail[r] + lead < amount) {
        amount = trail[r] + lead
      }
    }

    for (r = 0; r < height; r++) {
      cut = (amount < trail[r]) ? amount : trail[r]
      keep = amount - cut
      remaining = trail[r] - cut
      fragment = substr(piece[r], keep + 1)
      body = rtrim(fragment)

      if (body == "") {
        trail[r] = remaining + length(fragment)
      } else {
        pad = (remaining > 0) ? sprintf("%" remaining "s", "") : ""
        out[r] = out[r] pad body
        trail[r] = length(fragment) - length(body)
      }
    }
  }

  for (r = 0; r < height; r++) {
    line = out[r]
    for (i = 1; i <= blocks; i++) {
      gsub(stand_in[i], block[i], line)
    }

    gsub(hardblank_mark, " ", line)
    sub(/ +$/, "", line)
    print line
  }
}

BEGIN {
  blocks = split("█ ▀ ▄ ▌ ▐", block, " ")
  for (i = 1; i <= blocks; i++) {
    stand_in[i] = sprintf("%c", i)
  }

  hardblank_mark = sprintf("%c", blocks + 1)

  for (i = 32; i <= 126; i++) {
    code_of[sprintf("%c", i)] = i
  }

  for (i = 1; i < 32; i++) {
    escaped[sprintf("%c", i)] = sprintf("\\x%02x", i)
  }

  escaped[sprintf("%c", 127)] = "\\x7f"

  load_font()

  if (height == "") {
    print "Could not read the font file." >"/dev/stderr"
    aborted = 1
    exit 1
  }
}

{
  source[++source_count] = $0
  if (drawable($0)) {
    any_drawable = 1
  }
}

END {
  if (aborted) {
    exit 1
  }

  if (!any_drawable) {
    print "Nothing drawable: letters, digits and spaces only." >"/dev/stderr"
    exit 1
  }

  for (i = 1; i <= source_count; i++) {
    draw(source[i])
  }

  if (skipped_total > 0) {
    list = skipped_list[1]
    for (i = 2; i <= skipped_total; i++) {
      list = list " " skipped_list[i]
    }

    print "Skipped, no glyph: " list >"/dev/stderr"
  }
}
'
