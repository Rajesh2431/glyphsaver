# glyphsaver idle timeouts (seconds since idle began, not chained).
# Edit by hand or via: gly time 150
IDLE_SCREENSAVER=150
IDLE_WARN=540
IDLE_LOCK=600
IDLE_DPMS=720
IDLE_ICON="$HOME/.config/swaync/images/ja.png"
# Idle backend: swayidle (default, needs swayidle) or hypridle (needs hypridle).
# hypridle writes ~/.config/hypr/hypridle.conf from these values on first run
# or whenever this file changes.
# IDLE_BACKEND=swayidle
