#!/bin/bash
# glyphsaver-idle: run idle handler with glyphsaver timeouts.
# Settings live in ~/.config/glyphsaver/idle.conf (gly time edits it).
# Started via the glyphsaver-idle.service systemd user unit.
# Supports two backends (set IDLE_BACKEND in idle.conf):
#   swayidle (default) — feature-rich, widely used
#   hypridle            — Hyprland-native, no extra dependency
#
# Watchdog: if the backend process exits unexpectedly, it is restarted
# up to 5 times per minute (prevents tight crash loops).

set -u

IDLE_CONF="$HOME/.config/glyphsaver/idle.conf"
IDLE_SCREENSAVER=150
IDLE_WARN=540
IDLE_LOCK=600
IDLE_DPMS=720
IDLE_BACKEND="${IDLE_BACKEND:-swayidle}"
IDLE_ICON="$HOME/.config/swaync/images/ja.png"
# shellcheck disable=SC1090
[[ -f "$IDLE_CONF" ]] && source "$IDLE_CONF"

# systemd user units often lack Hyprland env vars. Discover them so
# hyprctl / socket paths work when started from the service.
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
  _sock=$(ls -td "$XDG_RUNTIME_DIR"/hypr/*/ 2>/dev/null | head -1)
  if [[ -n "${_sock:-}" ]]; then
    export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$_sock")"
  fi
fi
unset _sock

LAUNCHER="$(command -v glyphsaver 2>/dev/null || echo "$HOME/.local/bin/glyphsaver")"

# hyprctl form that works on Lua-mode and classic Hyprland alike.
dpms() {
  hyprctl keyword cursor:invisible false &>/dev/null
  hyprctl dispatch "hl.dsp.dpms({ action = \"$1\" })" &>/dev/null ||
    hyprctl dispatch dpms "$1" &>/dev/null || true
}

# --- backend launchers ---------------------------------------------------

launch_swayidle() {
  command -v swayidle &>/dev/null || {
    echo "swayidle is not installed: sudo pacman -S swayidle" >&2
    return 1
  }
  # shellcheck disable=SC2086
  exec swayidle -w \
    timeout "$IDLE_SCREENSAVER" "$LAUNCHER" resume "$LAUNCHER stop" \
    timeout "$IDLE_WARN" "notify-send -i \"$IDLE_ICON\" \" You are idle!\"" resume "notify-send -i \"$IDLE_ICON\" \" Oh! you're Back\" \" Hello !!!\"" \
    timeout "$IDLE_LOCK" "loginctl lock-session" \
    timeout "$IDLE_DPMS" "hyprctl dispatch \"hl.dsp.dpms({ action = \\\"off\\\" })\"" resume "hyprctl dispatch \"hl.dsp.dpms({ action = \\\"on\\\" })\"" \
    before-sleep "loginctl lock-session"
}

launch_hypridle() {
  command -v hypridle &>/dev/null || {
    echo "hypridle is not installed: sudo pacman -S hypridle" >&2
    return 1
  }
  local hconf="$HOME/.config/hypr/hypridle.conf"
  # Write a managed hypridle.conf on first run or when timestamps change.
  # Users can edit idle.conf to adjust times; this regenerates hconf.
  if [[ ! -f "$hconf" ]] || [[ "$IDLE_CONF" -nt "$hconf" ]]; then
    mkdir -p "$(dirname "$hconf")"
    cat > "$hconf" <<HYPREOF
# Generated by glyphsaver-idle — edit ~/.config/glyphsaver/idle.conf instead.
general {
    lock_cmd    = loginctl lock-session
    unlock_cmd  = loginctl unlock-session
    before_sleep_cmd = loginctl lock-session
    # Track keyboard/mouse idle only: ignore D-Bus ScreenSaver-inhibit
    # requests (e.g. "Playing video" from xdg-desktop-portal) so a
    # background app can't keep the saver from ever running.
    ignore_dbus_inhibit = true
}

listener {
    timeout = ${IDLE_DPMS}
    ignore_inhibit = true
    on-timeout = hyprctl dispatch "hl.dsp.dpms({ action = \\"off\\" })"
    on-resume  = hyprctl dispatch "hl.dsp.dpms({ action = \\"on\\" })"
}

listener {
    timeout = ${IDLE_SCREENSAVER}
    ignore_inhibit = true
    on-timeout = ${LAUNCHER}
    on-resume  = ${LAUNCHER} stop
}

listener {
    timeout = ${IDLE_WARN}
    ignore_inhibit = true
    on-timeout = notify-send -i "${IDLE_ICON}" " You are idle!"
    on-resume  = notify-send -i "${IDLE_ICON}" " Oh! you're Back" " Hello !!!"
}

listener {
    timeout = ${IDLE_LOCK}
    ignore_inhibit = true
    on-timeout = loginctl lock-session
}
HYPREOF
    echo "hypridle: wrote $hconf (source: idle.conf)"
  fi
  exec hypridle
}

# --- watchdog loop --------------------------------------------------------
# Restart the backend if it dies; cap at 5 restarts/minute to prevent crash loops.

run_backend() {
  local backend="$1"
  case "$backend" in
    swayidle) launch_swayidle ;;
    hypridle) launch_hypridle ;;
    *)
      echo "Unknown IDLE_BACKEND='$backend' — supported: swayidle, hypridle" >&2
      return 1
      ;;
  esac
}

restart_backend() {
  local backend="$IDLE_BACKEND"
  local wins=0 now marker_every=60 window_start=$SECONDS
  while true; do
    # Re-discover Hyprland signature in case of session restart.
    if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
      _sock=$(ls -td "$XDG_RUNTIME_DIR"/hypr/*/ 2>/dev/null | head -1)
      [[ -n "${_sock:-}" ]] && export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$_sock")"
      unset _sock
    fi

    # Reset restart counter every 60s.
    if ((SECONDS - window_start >= 60)); then
      wins=0; window_start=$SECONDS
    fi

    run_backend "$backend" &
    local pid=$!

    # Wait for exit; restart only when killed unexpectedly (not by us).
    wait "$pid" 2>/dev/null
    local rc=$?

    # Exit 0 → clean shutdown (e.g. signal from systemd stop).
    ((rc == 0)) && exit 0

    ((wins++))
    if ((wins > 5)); then
      echo "Idle backend '$backend' crashed $wins times in 60s — giving up." >&2
      exit 1
    fi

    echo "Idle backend '$backend' exited (rc=$rc), restarting (${wins}/5)..." >&2
    sleep 2
  done
}

case "${1:-run}" in
run)
  restart_backend
  ;;
dpms-off) dpms off ;;
dpms-on) dpms on ;;
*)
  echo "Usage: glyphsaver-idle [run|dpms-off|dpms-on]" >&2
  exit 1
  ;;
esac
