[Unit]
Description=Glyphsaver idle handling (screensaver + lock via swayidle/hypridle)
After=graphical-session.target hyprland-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# Local/dev installs symlink this to ~/.local/bin; the AUR package rewrites
# it to /usr/bin/glyphsaver-idle at build time (see PKGBUILD), and `setup`
# rewrites it to the real binary location on install.
ExecStart=%h/.local/bin/glyphsaver-idle
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
